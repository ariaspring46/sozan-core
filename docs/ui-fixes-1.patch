+          <button
+            type="button"
+            className="min-h-11 rounded-xl bg-accent px-4 text-sm font-bold text-onAccent"
+            onClick={() => {
+              setOffline(false);
+              setRetry((value) => value + 1);
+            }}
+          >
+            دوباره
+          </button>
+        </>
+      ) : (
+        <p className="text-sm text-muted">در حال بارگذاری…</p>
+      )}
+    </div>
+  );
 }

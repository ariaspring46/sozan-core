# Copy to ~/local-ai/config/sozan-voice.env and chmod 600.
# Do not commit the real password.

SIP_DOMAIN=phone.telefonchy.com
SIP_USER=
SIP_PASSWORD=
SIP_PORT=5060
SIP_REGISTER=1
LOCAL_SIP_PORT=5062
LOCAL_RTP_PORT=40000

LLM_URL=http://127.0.0.1:19292/v1
LLM_MODEL=ornith-phone
EMBED_URL=http://127.0.0.1:19292/v1/embeddings
EMBED_MODEL=bge-m3
EMBED_MIN=0.62

WHISPER_BIN=/home/demon/.final-27b/opt/whisper-194/whisper-cli
WHISPER_LIB=/home/demon/.final-27b/opt/whisper-194
WHISPER_MODEL=/home/demon/.final-27b/models/stt/ggml-large-v3-turbo-q5_0.bin
PIPER_BIN=/home/demon/.final-27b/bin/piper
PIPER_MODEL=/home/demon/.final-27b/models/tts/fa_IR-mana-medium.onnx
ESPEAK_DATA=/home/demon/.final-27b/bin/espeak-ng-data

VAD_START=450
VAD_KEEP=280
VAD_SILENCE_MS=220
VAD_MAX_MS=12000
VAD_COMMIT_MS=450
WHISPER_BEAM=1
WHISPER_AC=512
BARGE_MS=420
ECHO_CORR=0.55
PHRASE_MIN=0.72
PIPER_LENGTH=0.88
PIPER_NOISE=0.8
PIPER_NOISE_W=1.0
VOICE_CHAIN=ffmpeg
VOICE_PITCH=1.0
VOICE_GAIN=1.0
VOICE_PRESENCE_DB=5
VOICE_RMS=7300
GIFT_CODE_SPOKEN=

# Cloud brain is optional. Empty LLM_API_KEY keeps ornith-phone.
# Names only; the owner puts the value in sozan-voice.env (mode 600).
# LLM_URL=https://openrouter.ai/api/v1
# LLM_MODEL=
# LLM_API_KEY=
LLM_FALLBACK_URL=http://127.0.0.1:19292/v1
LLM_FALLBACK_MODEL=ornith-phone
LLM_LOCAL_URL=http://127.0.0.1:19292/v1
LLM_LOCAL_MODEL=qwen3.5-9b
LLM_TIMEOUT_S=8
# LLM_BENCH=1
# TTS_MODEL=google/gemini-3.8-flash-tts
# TTS_VOICE=Kore
# TTS_FIRST_S=6

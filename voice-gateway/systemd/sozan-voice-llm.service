[Unit]
Description=Sozan phone LLM on Vulkan1 (second GPU)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/local-ai
Environment=HOME=%h
# Vulkan1 is the second Radeon. Vulkan0 stays the always-on operator. Do not move this model.
ExecStart=%h/local-ai/llama.cpp/llama-server \
  --model %h/local-ai/models/Qwen3.5-9B-Q4_K_M.gguf \
  --host 127.0.0.1 --port 9219 \
  --alias sozan-voice \
  -ngl 99 --flash-attn on --jinja \
  --reasoning off \
  --reasoning-budget 0 \
  --device Vulkan1 \
  -c 16384 \
  -np 1 \
  --temp 0.4 \
  --top-p 0.8 \
  --top-k 20 \
  --min-p 0.0 \
  --presence-penalty 1.0 \
  --batch-size 512 \
  --ubatch-size 256 \
  --cache-type-k q4_0 \
  --cache-type-v q4_0
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=default.target

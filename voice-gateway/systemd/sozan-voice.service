[Unit]
Description=Sozan phone support (SIP to local Persian voice)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/work-f/Sozan-Core/voice-gateway
Environment=HOME=%h
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=%h/local-ai/config/sozan-voice.env
ExecStart=/usr/bin/python3 %h/work-f/Sozan-Core/voice-gateway/main.py
Restart=on-failure
RestartSec=5
TimeoutStartSec=240

[Install]
WantedBy=default.target

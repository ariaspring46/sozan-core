JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRE_MINUTES=720
ADMIN_PHONE=09120000000
OTP_TTL_SECONDS=300
OTP_DEV=true
# phone:123456,phone:123456 — empty means no fixed login codes
OTP_FIXED_ACCOUNTS=

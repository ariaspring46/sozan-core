[Unit]
Description=Sozan Unipile SOCKS via Tailscale OVH node
After=network-online.target tailscaled.service
Wants=network-online.target tailscaled.service

[Service]
Type=simple
User=ubuntu
ExecStart=/usr/bin/ssh -N -o StrictHostKeyChecking=accept-new -o ServerAliveInterval=15 -o ServerAliveCountMax=3 -o ExitOnForwardFailure=yes -o IdentitiesOnly=yes -i /home/ubuntu/.ssh/id_ed25519_to_node1 -D 127.0.0.1:10890 root@100.64.181.40
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
